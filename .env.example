# Скопируйте этот файл в .env и измените значения под своё окружение:
# cp .env.example .env

# Обязательно смените SECRET_KEY в production (можно сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-change-me-before-production

# Режим отладки: true для разработки, false для production
DEBUG=true

# Разрешённые хосты через запятую (* — только для локальной разработки)
ALLOWED_HOSTS=127.0.0.1,localhost

# --- База данных ---
# Движок: sqlite (по умолчанию) или postgresql
DB_ENGINE=sqlite

# SQLite: имя файла БД относительно папки hr_service/
DB_NAME=db.sqlite3

# PostgreSQL (раскомментируйте и заполните при DB_ENGINE=postgresql):
# DB_ENGINE=postgresql
# DB_NAME=hr_service
# DB_USER=hr_user
# DB_PASSWORD=strong_password
# DB_HOST=localhost
# DB_PORT=5432

# --- Локализация ---
LANGUAGE_CODE=ru
TIME_ZONE=Europe/Moscow

# --- Статика и медиа ---
STATIC_URL=static/
MEDIA_URL=media/
MEDIA_ROOT=media
